  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.Default.props" />
  <!-- Prefer v143, the tested toolset. Fall back to the installed Visual Studio's
       default toolset when v143 is absent, which otherwise fails with MSB8020. -->
  <PropertyGroup Label="Configuration"><ConfigurationType>Application</ConfigurationType><PlatformToolset>v143</PlatformToolset><PlatformToolset Condition="!Exists('$(VCTargetsPath)\Platforms\x64\PlatformToolsets\v143\Toolset.props') And '$(DefaultPlatformToolset)' != ''">$(DefaultPlatformToolset)</PlatformToolset><CharacterSet>Unicode</CharacterSet></PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.props" />
