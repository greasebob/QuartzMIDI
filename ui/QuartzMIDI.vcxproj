  <ItemDefinitionGroup>
    <!-- Level3 because the vendored ImGui sources are not warning-clean at Level4. -->
    <ClCompile><AdditionalOptions>/d1trimfile:"$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..'))" %(AdditionalOptions)</AdditionalOptions><WarningLevel>Level3</WarningLevel><LanguageStandard>stdcpp20</LanguageStandard><Optimization>MaxSpeed</Optimization><RuntimeLibrary>MultiThreaded</RuntimeLibrary><ExceptionHandling>Sync</ExceptionHandling><PreprocessorDefinitions>WIN32;_WINDOWS;UNICODE;_UNICODE;__WINDOWS_MM__;%(PreprocessorDefinitions)</PreprocessorDefinitions><AdditionalIncludeDirectories>$(MSBuildThisFileDirectory)..\third_party\imgui;$(MSBuildThisFileDirectory)..\engine;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories><MultiProcessorCompilation>true</MultiProcessorCompilation></ClCompile>
    <Link><SubSystem>Windows</SubSystem><AdditionalOptions>/PDBALTPATH:%_PDB% %(AdditionalOptions)</AdditionalOptions><AdditionalDependencies>d3d11.lib;dxgi.lib;d3dcompiler.lib;user32.lib;gdi32.lib;dwmapi.lib;avrt.lib;winmm.lib;ole32.lib;shell32.lib;comdlg32.lib;%(AdditionalDependencies)</AdditionalDependencies></Link>
