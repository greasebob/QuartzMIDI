  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.targets" />
  <!-- The app trusts a single add-on signing key. Generate one if none exists and
       write its public half to build\addon-key\AddonKey.hpp. Override with
       /p:AddonKey=<file>; addons\sheets\sheets.vcxproj signs with the same key. -->
  <PropertyGroup><AddonKey Condition="'$(AddonKey)' == ''">$(MSBuildThisFileDirectory)..\build\addon-key\key.bin</AddonKey></PropertyGroup>
  <Target Name="AddonKeyHeader" BeforeTargets="ClCompile">
    <Exec Command="&quot;%SystemRoot%\System32\WindowsPowerShell\v1.0\powershell.exe&quot; -NoProfile -NonInteractive -ExecutionPolicy Bypass -File &quot;$(MSBuildThisFileDirectory)..\tools\sign-addon.ps1&quot; -MakeKey -Key &quot;$(AddonKey)&quot; -Header &quot;$(MSBuildThisFileDirectory)..\build\addon-key\AddonKey.hpp&quot;" />
  </Target>
  <Target Name="CopyShellDefaults" AfterTargets="Build">
    <Copy SourceFiles="$(MSBuildThisFileDirectory)..\x64\Release\config.json" DestinationFiles="$(OutDir)config.json" Condition="!Exists('$(OutDir)config.json')" />
    <Copy SourceFiles="$(MSBuildThisFileDirectory)..\third_party\fonts\ibm-plex-sans\LICENSE.txt" DestinationFiles="$(OutDir)IBM-Plex-LICENSE.txt" SkipUnchangedFiles="true" />
    <Copy SourceFiles="$(MSBuildThisFileDirectory)..\third_party\imgui\LICENSE.txt" DestinationFiles="$(OutDir)ImGui-LICENSE.txt" SkipUnchangedFiles="true" />
    <Copy SourceFiles="$(MSBuildThisFileDirectory)..\third_party\midi-converter\LICENSE" DestinationFiles="$(OutDir)midi-converter-LICENSE.txt" SkipUnchangedFiles="true" />
    <Copy SourceFiles="$(MSBuildThisFileDirectory)..\third_party\lucide\LICENSE" DestinationFiles="$(OutDir)Lucide-LICENSE.txt" SkipUnchangedFiles="true" />
    <Copy SourceFiles="$(MSBuildThisFileDirectory)..\third_party\rtmidi\LICENSE" DestinationFiles="$(OutDir)RtMidi-LICENSE.txt" SkipUnchangedFiles="true" />
    <Copy SourceFiles="$(MSBuildThisFileDirectory)..\third_party\nlohmann-json\LICENSE.MIT" DestinationFiles="$(OutDir)nlohmann-json-LICENSE.txt" SkipUnchangedFiles="true" />
    <Copy SourceFiles="$(MSBuildThisFileDirectory)..\LICENSE" DestinationFiles="$(OutDir)LICENSE" SkipUnchangedFiles="true" />
  </Target>
